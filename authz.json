        "min": "connect"
      }
    },
    "DELETE /plugin-api/cron/:hostId/system/:name": {
      "access": "user",
      "permission": "cron.use",
      "resource": {
        "kind": "host",
        "min": "connect"
      },
      "destructive": true,
